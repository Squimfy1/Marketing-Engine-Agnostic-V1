# Authentication: NONE required here.
# The engine drives the Claude Code CLI under the hood, which uses your existing
# Claude Code login (subscription). No ANTHROPIC_API_KEY is needed.
# (You may still set ANTHROPIC_API_KEY to force raw-API auth instead, but it's optional.)

# Root of the Obsidian vault the engine reads/writes.
# Layout: $VAULT_ROOT/tenants/<tenant_id>/brands/<brand_id>/...
VAULT_ROOT=./vault
